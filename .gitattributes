# GCC/Clang reject UTF-16 sources (MSVC accepts them). OneDrive/Windows editors
# have rewritten forecast/codec files as UTF-16 and broken Linux CI since v2.3.25.
*.cpp text working-tree-encoding=UTF-8
*.hpp text working-tree-encoding=UTF-8
*.h text working-tree-encoding=UTF-8
*.c text working-tree-encoding=UTF-8
*.cu text working-tree-encoding=UTF-8
*.ps1 text working-tree-encoding=UTF-8

# Shell entrypoints must stay LF so WSL/bash do not see CRLF in `set -o pipefail`.
scripts/*.sh text eol=lf
# Pip requirement files: normalize line endings (helps Windows tools and `pip install -r`).
requirements-verify.txt text eol=lf
requirements-pip-merged.txt text eol=lf
cypha_studio/requirements.txt text eol=lf
