inline bool try_load(int n, int d, std::uint64_t seed,
                     std::vector<std::vector<double>>& xs, std::vector<std::string>& ys) {
  auto fill = [&](std::size_t nn, std::size_t dd, const double* flat, const char* const* labels) {
    xs.assign(nn, std::vector<double>(dd));
    ys.resize(nn);
    for (std::size_t i = 0; i < nn; ++i) {
      for (std::size_t j = 0; j < dd; ++j) xs[i][j] = flat[i * dd + j];
      ys[i] = labels[i];
    }
  };
  if (n == 400 && d == 10 && seed == 42ull) {
    fill(linsep_n, linsep_d, &k_linsep_xs[0][0], k_linsep_ys);
    return true;
  }
  if (n == 400 && d == 8 && seed == 7ull) {
    fill(blobs_n, blobs_d, &k_blobs_xs[0][0], k_blobs_ys);
    return true;
  }
  return false;
}
