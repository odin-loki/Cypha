# Cypha — .gitignore

# =====================================================
# Large Dataset & Model Files
# =====================================================

*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.npz
*.npy
models/
weights/
checkpoints/
snapshots/
training/
experiment/
experiments/

# =====================================================
# Log Files
# =====================================================

logs/*.log
logs/*.txt
*.log
logs/

# =====================================================
# Python (legacy — runtime removed; cache only)
# =====================================================

__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.benchmarks/

# =====================================================
# IDE / OS
# =====================================================

.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# =====================================================
# Cypha-specific data
# =====================================================

bessel_ratios.npz
*.npz
*.bin
kernel_*_roundtrip_out.cypha

config/*.jsonl
config/*.yaml
config/*.yml

# =====================================================
# Build artifacts
# =====================================================

build/
dist/
*.egg-info/
*.egg
MANIFEST
*.so
*.pyd

native/build*/
native/build-*/
native/build_*/
native/build/

*.dll
*.lib
*.obj
*.pdb
*.ilk
*.exp
*.exe

# =====================================================
# Bench data & generated reports
# =====================================================

bench/data/mnist/
bench/data/wikitext2/
!bench/data/wikitext2/README.md
bench/artifacts/
bench/report/baselines/
bench/report/figures/
bench/report/tables/
bench/report/summary.json

# Legacy paths (pre bench/ rename)
bench/data/mnist/
bench/data/wikitext2/
!bench/data/wikitext2/README.md
bench/artifacts/tuning/
bench/report/baselines/

data_cache/
/results/
bench/results/*
!bench/results/.gitkeep
results/*.json
cypha_diagnostics/results/

# =====================================================
# Temporary / local scratch
# =====================================================

*.tmp
*.bak
*.backup
*.cache
.env
.env.local
.env.*.local
*.pem
*.key
*.secret
.bash_history

Cypha Tests.txt

# Accidental Windows path artifact (e.g. mkdir C: from bad script)
/C?/

# =====================================================
# Documentation build (optional)
# =====================================================

docs/site/
*.html
!native/tools/static/*.html
*.md.html
*_test.html
*_demo.html
*.pickle
*.joblib
