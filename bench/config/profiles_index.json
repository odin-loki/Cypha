{
  "description": "Cypha bench profile registry — domain-specific hyperparameter bundles.",
  "classification": {
    "path": "everyday_profile.json",
    "regime": "tabular",
    "loader": "cypha_bench.config.load_profile.classification_params"
  },
  "auto_rff_gamma_cv": {
    "path": "auto_rff_gamma_cv_profile.json",
    "regime": "tabular",
    "env": "CYPHA_BENCH_PROFILE_PATH=bench/config/auto_rff_gamma_cv_profile.json",
    "domains": ["d01"]
  },
  "vision": {
    "path": "everyday_profile.json",
    "regime": "vision",
    "loader": "cypha_bench.config.load_profile.classification_params"
  },
  "regression": {
    "path": "everyday_profile.json",
    "regime": "regression",
    "loader": "cypha_bench.config.load_profile.regression_params"
  },
  "llm": {
    "path": "profiles/cyphalm_llm.json",
    "env": "CYPHALM_PROFILE=llm",
    "domains": ["d04", "d17"]
  },
  "llm_d04": {
    "path": "profiles/cyphalm_d04_gutenberg.json",
    "env": "CYPHALM_PROFILE=d04",
    "domain": "d04",
    "corpus": "gutenberg"
  },
  "llm_d17": {
    "path": "profiles/cyphalm_d17_wikitext.json",
    "env": "CYPHALM_PROFILE=d17",
    "domain": "d17",
    "corpus": "wikitext2"
  },
  "llm_d17_full": {
    "path": "profiles/cyphalm_d17_wikitext.json",
    "config": "d17_wikitext_full_profile.json",
    "env": "CYPHA_BENCH_FULL_CORPUS=1",
    "domain": "d17",
    "corpus": "wikitext2",
    "notes": "Official train/valid split; see bench/config/d17_wikitext_full_profile.json"
  },
  "llm_d17_overnight": {
    "path": "profiles/cyphalm_d17_wikitext.json",
    "config": "d17_wikitext_overnight_profile.json",
    "env": "CYPHA_BENCH_OVERNIGHT=1;CYPHA_BENCH_FULL_CORPUS=1",
    "domain": "d17",
    "corpus": "wikitext2",
    "notes": "300k token budget overnight run; see bench/config/d17_wikitext_overnight_profile.json"
  },
  "llm_d21_rpsm": {
    "path": "profiles/cyphalm_d21_rpsm.json",
    "config": "d21_rpsm_profile.json",
    "env": "CYPHA_BENCH_OVERNIGHT=1;CYPHA_BENCH_FULL_CORPUS=1",
    "domain": "d21",
    "corpus": "wikitext2",
    "notes": "300k RPSM end-to-end train; see bench/config/d21_rpsm_profile.json"
  },
  "intelligence_cross_d22": {
    "path": "everyday_profile.json",
    "config": "d22_intelligence_cross_profile.json",
    "env": "CYPHA_BENCH_FAST=1",
    "domain": "d22",
    "notes": "Cross-domain intelligence bench; see bench/config/d22_intelligence_cross_profile.json"
  },
  "overnight_lock_d23": {
